# Keep every text file in the repository as LF, on every platform.
#
# install.sh and update.sh are shell scripts. A CRLF checkout breaks them on
# Linux and macOS with "bad interpreter: /bin/sh^M", so the line endings are
# pinned here rather than left to each contributor's core.autocrlf setting.
* text=auto eol=lf

# The built dashboard is published as-is and is generated by Vite.
frontend/dist/** text eol=lf
